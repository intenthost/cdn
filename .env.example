# ==============================================================================
# Intent CDN - Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Branding & Domains
APP_NAME="Intent CDN"
APP_ADMIN_DOMAIN="https://admin.yourdomain.com"
STORAGE_PUBLIC_DOMAIN="https://cdn.yourdomain.com"

# Cloud Storage Credentials (R2 / S3 compatible)
STORAGE_ACCOUNT_ID="your_account_id_here"
STORAGE_ACCESS_KEY="your_access_key_id_here"
STORAGE_SECRET_KEY="your_secret_access_key_here"
STORAGE_BUCKET="your_bucket_name_here"
STORAGE_API_TOKEN="your_cloudflare_api_token_here"
STORAGE_ENDPOINT="" # Leave blank to auto-use {STORAGE_ACCOUNT_ID}.r2.cloudflarestorage.com
STORAGE_REGION="auto"

# Authentication Credentials (No signup - admin login credentials)
AUTH_USERNAME="admin"
AUTH_PASSWORD="your_secure_password_here"

# Session Duration in Seconds (30 Days = 2592000)
SESSION_LIFETIME="2592000"

# Realtime Engine (sse or ws)
REALTIME_MODE="sse"
WEBSOCKET_URL=""
